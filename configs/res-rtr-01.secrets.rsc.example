# =============================================================================
# res-rtr-01 - SECRETS (modele)
# Copier en res-rtr-01.secrets.rsc (ignore par Git), remplacer chaque <...>,
# importer APRES res-rtr-01.rsc, puis supprimer le fichier du routeur :
#   /import file-name=res-rtr-01.secrets.rsc
#   /file remove res-rtr-01.secrets.rsc
# =============================================================================

# --- Compte d'administration --------------------------------------------------
/user add name="<ADMIN_UTILISATEUR>" group=full password="<ADMIN_MOT_DE_PASSE_LONG>"
# Ensuite, se reconnecter avec ce compte, PUIS seulement :  /user remove admin

# --- Wi-Fi --------------------------------------------------------------------
/interface wifi security set sec-maison passphrase="<WIFI_MAISON_MOT_DE_PASSE>"
/interface wifi security set sec-iot passphrase="<WIFI_IOT_MOT_DE_PASSE>"
/interface wifi security set sec-invites passphrase="<WIFI_INVITES_MOT_DE_PASSE>"
/interface wifi enable [find]

# --- SNMP v3 (pour Zabbix, depuis le VLAN SERV uniquement) --------------------
/snmp community add name="<SNMP_UTILISATEUR>" security=private addresses=10.1.20.0/24 authentication-protocol=SHA1 authentication-password="<SNMP_AUTH_MOT_DE_PASSE>" encryption-protocol=AES encryption-password="<SNMP_CHIFFREMENT_MOT_DE_PASSE>"
/snmp set enabled=yes contact="<CONTACT>" location="Residence"

# --- Mikhmon (API, etape B) : compte dedie, droits limites ---------------------
/user add name=mikhmon group=mikhmon password="<MIKHMON_MOT_DE_PASSE_LONG>"

# --- Hotspot : compte de test -------------------------------------------------
/ip hotspot user add name="<HOTSPOT_TEST_UTILISATEUR>" password="<HOTSPOT_TEST_MOT_DE_PASSE>" profile=up-standard
